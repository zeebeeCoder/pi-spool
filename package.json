{
  "name": "pi-spool",
  "version": "0.1.0-experimental.1",
  "private": true,
  "type": "module",
  "description": "Experimental Pi durable-work extension backed by Absurd",
  "keywords": [
    "pi-package",
    "durable-work",
    "absurd"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "absurd-sdk": "0.5.0",
    "pg": "8.16.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@testcontainers/postgresql": "11.7.2",
    "@types/node": "22.18.11",
    "@types/pg": "8.15.5",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
